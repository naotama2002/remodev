# --- credentials: only the control plane and the per-session proxy see these ---
# Fine-grained PAT (or GitHub App token) with Contents + Pull requests: read/write
# on the repositories below. Protect main with a ruleset: remodev pushes remodev/* only.
REMODEV_GITHUB_TOKEN=
# Either an Anthropic API key ...
REMODEV_ANTHROPIC_API_KEY=
# ... or a Claude subscription token from `claude setup-token`
REMODEV_CLAUDE_OAUTH_TOKEN=

# Repositories sessions may target (comma separated globs)
REMODEV_ALLOWED_REPOS=naotama2002/*

# Egress: nono network profile + extra domains
REMODEV_NETWORK_PROFILE=developer
REMODEV_ALLOW_DOMAINS=

# Sandbox resources / lifecycle
REMODEV_SANDBOX_MEMORY_MB=4096
REMODEV_SANDBOX_CPUS=2
REMODEV_IDLE_STOP=30m
REMODEV_RETAIN=168h
# Optional stronger isolation when installed on the host: runsc (gVisor) or kata
REMODEV_SANDBOX_RUNTIME=
